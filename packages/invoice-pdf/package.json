{
  "name": "@eyadex/invoice-pdf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure invoice PDF model with an explicit bounded Node runtime subpath.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "eyadex-runtime": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "eyadex-runtime": "./dist/runtime/index.js",
      "default": "./src/runtime/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eyadex/config": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@eyadex/contracts": "workspace:*"
  }
}
