{
  "name": "@eyadex/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Better Auth configuration — the ONLY place sessions and passwords are handled (CLAUDE.md §8)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.7",
    "@eyadex/db": "workspace:*",
    "@eyadex/ids": "workspace:*",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eyadex/config": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
