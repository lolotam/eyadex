    "test": "vitest run"
  },
  "devDependencies": {
    "@eyadex/config": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
