{
  "name": "eyadex",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "12.5.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "ignore"
    }
  },
  "scripts": {
    "dev": "cd apps/web && ./node_modules/.bin/vite dev",
    "build:dev": "cd apps/web && ./node_modules/.bin/vite build --mode development && rm -rf ../../dist && cp -R dist ../../dist",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "cd apps/web && ./node_modules/.bin/vite build && rm -rf ../../dist && cp -R dist ../../dist",
    "build:all": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.11.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "rolldown": "1.2.1"
  }
}
