{
  "name": "@eyadex/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Eyadex worker — the NestJS container that runs the outbox dispatcher (invitation email)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "start": "node --conditions=eyadex-runtime --env-file-if-exists=../../.env dist/main.js"
  },
  "dependencies": {
    "@eyadex/db": "workspace:*",
    "@eyadex/ids": "workspace:*",
    "@eyadex/observability": "workspace:*",
    "@eyadex/secrets": "workspace:*",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "fastify": "5.12.4",
    "nodemailer": "10.0.15",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eyadex/config": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
