{
  "name": "@eyadex/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Eyadex HTTP API — NestJS on the Fastify adapter",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@eyadex/auth": "workspace:*",
    "@eyadex/contracts": "workspace:*",
    "@eyadex/db": "workspace:*",
    "@eyadex/ids": "workspace:*",
    "@eyadex/observability": "workspace:*",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eyadex/config": "workspace:*",
    "@nestjs/testing": "12.0.3",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "postgres": "3.4.9",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
