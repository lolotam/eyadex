# Copy to .env and replace every "change-me". Never commit .env.
WEB_PORT=3000

POSTGRES_DB=eyadex
POSTGRES_PORT=5432
POSTGRES_OWNER_USER=eyadex_owner
POSTGRES_OWNER_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
AUTH_DB_PASSWORD=change-me-auth
PLATFORM_DB_PASSWORD=change-me-platform
DISPATCHER_DB_PASSWORD=change-me-dispatcher

REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# Local MinIO for attachments (docker-compose only; staging and production use Dokploy, see
# docs/specs/medical-blob-runbook.md). The root pair never goes to a deployed API. Letters, digits and hyphens
# only: the bucket init passes the pair inside a URL.
MINIO_PORT=9000
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password

# apps/api — the eyadex_app runtime role (optional until the first module is mounted).
DATABASE_URL=postgres://eyadex_app:change-me-app@localhost:5432/eyadex

# packages/auth — Better Auth on the eyadex_auth role only; secret: 32+ random characters.
AUTH_DATABASE_URL=postgres://eyadex_auth:change-me-auth@localhost:5432/eyadex
BETTER_AUTH_SECRET=change-me-to-32-or-more-random-characters

# apps/api same-origin auth (ADR-0004): each area's origin; distinct hosts, exact Host match.
APP_URL=http://localhost:3000
PLATFORM_URL=http://platform.localhost:3000
# apps/api auth rate limiting (ADR-0005); required when auth is mounted. Redis down = auth routes answer 503.
REDIS_URL=redis://:change-me-redis@localhost:6379/0
# Reverse proxies in front of the API whose X-Forwarded-Host is trusted; 0 = use Host only.
TRUST_PROXY_HOPS=0
# ADR-0021: the environment's cookie prefix. Empty = production's names (eyadex-clinic.*, eyadex-platform.*);
# staging sets its own so its cookies never share a name with production's. Lowercase words and hyphens.
AUTH_COOKIE_PREFIX=
# apps/api platform area (ADR-0006): the eyadex_platform pool and the outbox seal key (32 random bytes, base64).
# The worker needs the same OUTBOX_SEAL_KEY to open invitation links. Generate: openssl rand -base64 32
PLATFORM_DATABASE_URL=postgres://eyadex_platform:change-me-platform@localhost:5432/eyadex
OUTBOX_SEAL_KEY=
# ADR-0014 (7c-2): seals clinic mail credentials; required by the API (seals; startup fails without it when the
# clinic area is mounted) and the worker (opens).
# A different key from OUTBOX_SEAL_KEY. Generate: openssl rand -base64 32
# Phase 3 N2: the same key seals the clinic's WhatsApp coexistence (Meta) access token.
MAIL_PROVIDER_SEAL_KEY=
# Phase 3 N2 (docs/specs/notifications-design.md §7.1): the dedicated Evolution API container on the
# internal network (api + worker), e.g. http://eyadex-evolution:8080 — an http(s) origin, no path. Both or
# neither: both unset disables QR linking and Evolution sends only; direct Meta coexistence still works.
# One without the other stops the start. The key is Evolution's global AUTHENTICATION_API_KEY.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# API only: both required with Evolution, both unset without it. Secret: at least 32 characters.
# URL as Evolution reaches the API: http://eyadex-api:3000/v1/hooks/evolution (Dockerfile listens on
# 0.0.0.0:3000); a bare local API defaults to 0.0.0.0:3001, so use that port outside the container.
# Generate a separate secret with openssl rand -hex 32; never reuse the global Evolution key.
EVOLUTION_WEBHOOK_URL=
EVOLUTION_WEBHOOK_SECRET=
# Phase 3 N3 (docs/specs/notifications-design.md §7.2), API only: the Eyadex Meta app (Tech Provider). All four
# or none: none = Embedded Signup and the status webhook answer 404 (the manual coexistence form still works);
# a partial set stops the start naming the missing variable. META_APP_ID and META_WHATSAPP_CONFIG_ID are the
# public 5-30 digit ids (App Dashboard; WhatsApp > Embedded Signup configuration). META_APP_SECRET signs the
# webhook (X-Hub-Signature-256) and exchanges signup codes; never in the browser. META_WEBHOOK_VERIFY_TOKEN is
# yours, at least 32 characters (openssl rand -hex 32), typed into Meta's webhook settings beside the callback
# URL: the public HTTPS address at which the proxy serves the API's /v1/hooks/meta.
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
# ADR-0028: the medical field keys. API: startup fails when the clinic area is mounted and
# MEDICAL_MASTER_KEY_V<MEDICAL_KEY_VERSION> or MEDICAL_INDEX_KEY is missing or malformed. Worker: the same
# MEDICAL_MASTER_KEY_V<n> + MEDICAL_KEY_VERSION open the prescription lines for the prescription email (phase 3
# N1); without them that one message fails with `no_medical_key`, every other message still goes out. The
# worker never needs MEDICAL_INDEX_KEY.
# Generate one value per variable per environment and keep offline copies: losing one loses the data.
# The index key is never rotated. See docs/specs/medical-keys-runbook.md. Never commit a value.
MEDICAL_MASTER_KEY_V1=
MEDICAL_KEY_VERSION=1
MEDICAL_INDEX_KEY=
# P2 attachments (spec §6): a private S3-compatible bucket (MinIO on Dokploy, internal network only; see
# docs/specs/medical-blob-runbook.md). Set the four required values or none: none = the API starts and only an
# attachment upload or download answers 503; some = the API refuses to start. The endpoint is an http(s)
# origin with no path (http on the internal Docker network, e.g. http://<minio-service>:9000); the region
# defaults to us-east-1. Only ciphertext is stored, under clinic/<clinic>/<attachment>. Deployed APIs use a
# user limited to the bucket; locally, http://localhost:9000 with the root pair above is enough.
# Never commit a key.
MEDICAL_BLOB_S3_ENDPOINT=
MEDICAL_BLOB_S3_BUCKET=
MEDICAL_BLOB_S3_ACCESS_KEY=
MEDICAL_BLOB_S3_SECRET_KEY=
MEDICAL_BLOB_S3_REGION=

# apps/worker — the outbox dispatcher (ADR-0013). DATABASE_URL (eyadex_app, above) reads the invitation under
# its clinic; this one is the eyadex_dispatcher role: outbox_events only, plus the ADR-0022 purge functions.
# OUTBOX_SEAL_KEY and APP_URL above are shared with the API. Never commit a real Resend key.
DISPATCHER_DATABASE_URL=postgres://eyadex_dispatcher:change-me-dispatcher@localhost:5432/eyadex
RESEND_API_KEY=
MAIL_FROM=Eyadex Team <no-reply@eyadex.com>
# Optional platform SMTP fallback (ADR-0014): set all four or none; port 465 = implicit TLS, else STARTTLS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
OUTBOX_POLL_INTERVAL_MS=2000
# Finance F1 (C1, docs/specs/finance-design.md §8c.1): seals each invoice link token so a retried send re-sends
# the same link. Worker only (the API never seals or opens one); a key of its own. Generate:
# openssl rand -base64 32. Unset: invoice messages stay queued until it is set; every other message still
# sends. Rotate only after the invoice queue is drained (a rotated key revokes and replaces live links).
INVOICE_LINK_SEAL_KEY=
# ADR-0020: the worker also needs PLATFORM_DATABASE_URL and PLATFORM_URL (above) for the expiry reminder scan
# and platform-team invitation links. How often the scan runs (ms, 60000 to 86400000; default one hour).
EXPIRY_SCAN_INTERVAL_MS=3600000
# Phase 3 N1 (docs/specs/notifications-design.md §3.2): how often the appointment reminder scan runs (ms,
# 60000 to 86400000; default five minutes). The day-before and 2-hour windows are fixed in the worker; the
# patient_notifications ledger keeps each reminder to once per appointment start however often it runs.
REMINDER_SCAN_INTERVAL_MS=300000
# ADR-0022: how often the retention purge runs on the dispatcher pool (ms, 60000 to 86400000; default one
# hour). The periods themselves (30 / 30 / 90 days) are fixed in db/sql/0040, not here.
RETENTION_PURGE_INTERVAL_MS=3600000

# apps/web — which data adapter the build uses (build time): "mock" (default; demo data in the
# browser, the Lovable preview) or "http" (the real API on the same origin under /api, ADR-0004).
VITE_API_MODE=mock
# ADR-0021: the two area hosts, compiled in at build time like VITE_API_MODE. Empty = the production rules
# (`app.` is the clinic, `platform.` the platform, `localhost` the clinic in development). When set, only
# these two exact hosts are areas. Both or neither; bare host names (no scheme, no port).
VITE_APP_HOST=
VITE_PLATFORM_HOST=

# apps/api one-off bootstrap (ADR-0021): the first platform account on a fresh database. Passed to
# `docker exec -e` for the run only; the password is read from stdin, never from a variable or argument.
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=

# ---- Staging (ADR-0021, docs/specs/staging-runbook.md) ----
# The same variables, set in each *-staging Dokploy service. Every secret is generated fresh for staging;
# never copy or reference a production value. Non-secret staging values:
#   web build args:  VITE_API_MODE=http  VITE_APP_HOST=staging-app.eyadex.com
#                    VITE_PLATFORM_HOST=staging-platform.eyadex.com
#   api + worker:    APP_URL=https://staging-app.eyadex.com
#   api:             PLATFORM_URL=https://staging-platform.eyadex.com  TRUST_PROXY_HOPS=1
#                    AUTH_COOKIE_PREFIX=eyadex-staging
#   worker:          MAIL_FROM=Eyadex Staging <no-reply-staging@eyadex.com>
# Staging secrets (pasted by the owner): BETTER_AUTH_SECRET, OUTBOX_SEAL_KEY, MAIL_PROVIDER_SEAL_KEY,
# INVOICE_LINK_SEAL_KEY (worker only),
# MEDICAL_MASTER_KEY_V1, MEDICAL_INDEX_KEY (api only; docs/specs/medical-keys-runbook.md), EVOLUTION_API_KEY (api + worker), RESEND_API_KEY, the four runtime role passwords inside DATABASE_URL / AUTH_DATABASE_URL /
# PLATFORM_DATABASE_URL / DISPATCHER_DATABASE_URL, the Redis password inside REDIS_URL, the Postgres
# owner password, optional SMTP_PASSWORD.
